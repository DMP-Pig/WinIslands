<Window x:Class="WinIslands.UI.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIslands 日志" Width="720" Height="460" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterScreen" Background="#161622" Foreground="#F5F5FA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="应用日志（logs 目录）" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshBtn" Content="刷新" Width="72" Height="30" HorizontalAlignment="Right"
                    Padding="8,0" Click="Refresh_Click" Background="#2A2A3A" Foreground="White"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>
        <Border Grid.Row="1" Background="#0E0E18" CornerRadius="10" BorderBrush="#2A2A3A" BorderThickness="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <TextBlock x:Name="LogText" Text="" FontSize="11.5" LineHeight="18"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="FileLabel" Grid.Row="2" Margin="0,8,0,0" Opacity="0.6" FontSize="11"/>
    </Grid>
</Window>
