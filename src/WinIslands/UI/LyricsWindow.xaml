<Window x:Class="WinIslands.UI.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics" Width="420" Height="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="LyricText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding LyricsFontSize, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=16}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="#CC101018" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid Margin="14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#DDDDEE"/>
                <TextBlock Text=" — " FontSize="11" Foreground="#8888AA"/>
                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#DDDDEE"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding LyricLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource LyricText}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
