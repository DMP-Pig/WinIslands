                                <Slider Minimum="240" Maximum="620" Value="{Binding Working.MaxExpandedHeight}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="ExpandedHeight" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkExpandedHeightAuto" IsChecked="{Binding Working.MaxExpandedHeightAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
