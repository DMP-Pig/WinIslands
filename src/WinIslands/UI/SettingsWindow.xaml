                                       TextWrapping="Wrap" Margin="0,0,0,10" MaxWidth="520"/>
                            <ItemsControl ItemsSource="{Binding QuickActionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                Padding="10,6" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
