                        <TextBlock x:Name="LblLyricsKaraokeSpeed" Style="{StaticResource Label}" Text="卡拉OK速度"/>
                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding Working.KaraokeSpeed}" Width="300" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="0.1"/>
