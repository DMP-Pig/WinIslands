                </TabItem>

                <TabItem x:Name="TabComponents" Header="组件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,6">
                            <TextBlock x:Name="LblCompOrder" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,2,2,4"/>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="0" Margin="0,0,0,8">
                                <ScrollViewer x:Name="OrderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Padding="8,6" PreviewMouseWheel="OrderScroll_PreviewMouseWheel">
                                    <ItemsControl x:Name="OrderStrip" ItemsSource="{Binding OrderItems}" AllowDrop="True"
                                                  PreviewDragOver="OrderStrip_PreviewDragOver" PreviewDrop="OrderStrip_Drop">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Chip" CornerRadius="9" Padding="16,7" Margin="4" Cursor="Hand"
                                                        Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                        PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown" PreviewMouseMove="Chip_PreviewMouseMove">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Border CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="4,2">
                                <StackPanel>
                                    <Grid Margin="2,6,2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblCompName" Text="组件" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="LblCompIcon" Grid.Column="1" Text="图标" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="LblCompIdle" Grid.Column="2" Text="无歌曲播放时" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="LblCompPlaying" Grid.Column="3" Text="有歌曲播放时" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4,2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="104"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
