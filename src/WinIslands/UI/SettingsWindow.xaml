                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="4,2">
                                <ItemsControl ItemsSource="{Binding MediaAppRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4,2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
