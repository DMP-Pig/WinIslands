                                      SelectedValue="{Binding Working.WaveStyle}">
                                <ComboBox.ItemsSource>
                                    <Binding Path="WaveStyleOptions"/>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <TextBlock x:Name="LblWaveSensitivity" Style="{StaticResource Label}"/>
                            <Slider Minimum="0.2" Maximum="3" Value="{Binding Working.WaveSensitivity}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblWaveHeight" Style="{StaticResource Label}"/>
                            <Slider Minimum="0.4" Maximum="1.6" Value="{Binding Working.WaveHeight}" Width="300" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtWaveNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="480" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblWidgets" Style="{StaticResource Label}"/>
                            <CheckBox x:Name="ChkShowWidgets" IsChecked="{Binding Working.ShowWidgetsWhenNoMedia}"/>
                            <CheckBox x:Name="ChkWidgetTime" IsChecked="{Binding Working.WidgetShowTime}"/>
                            <CheckBox x:Name="ChkWidgetWeather" IsChecked="{Binding Working.WidgetShowWeather}"/>
                            <TextBlock x:Name="LblWeatherCity" Style="{StaticResource Label}"/>
                            <TextBox x:Name="WeatherCityBox" Width="200" HorizontalAlignment="Left" Text="{Binding Working.WeatherCity}"/>
                            <TextBlock x:Name="TxtWidgetNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

