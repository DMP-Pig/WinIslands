                </TabItem>
                <TabItem x:Name="TabRules" Header="规则">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,6">
                        <TextBlock x:Name="LblRulesIntro" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RuleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            Padding="10,8" Margin="0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F4C4;" FontSize="13" VerticalAlignment="Center" Opacity="0.9"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="168" Padding="6,3"
                                                         FontSize="11.5" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                                                <CheckBox IsChecked="{Binding Enabled}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0,0,0"
                                                        Width="24" Height="24" Padding="0" VerticalAlignment="Center"
                                                        Background="Transparent" BorderThickness="0" Opacity="0.7"
                                                        Click="RuleRemove_Click"
                                                        ToolTip="删除规则"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ComboBox ItemsSource="{Binding ConditionOptions}" SelectedValuePath="Value"
                                                          DisplayMemberPath="Display" SelectedValue="{Binding Condition}" Width="170"
                                                          VerticalContentAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                            Visibility="{Binding IsTimeRange, Converter={StaticResource BoolToVis}}">
                                                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding StartHour}" Width="58"/>
                                                    <TextBlock Text="–" Margin="4,0" VerticalAlignment="Center" Opacity="0.7"/>
                                                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding EndHour}" Width="58"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding AppMatch, UpdateSourceTrigger=PropertyChanged}" Width="170" Padding="6,3"
                                                         FontSize="11.5" VerticalContentAlignment="Center" Margin="8,0,0,0"
                                                         Visibility="{Binding IsAppMatch, Converter={StaticResource BoolToVis}}"/>
                                                <ComboBox ItemsSource="{Binding ActionOptions}" SelectedValuePath="Value"
                                                          DisplayMemberPath="Display" SelectedValue="{Binding Action}" Width="132"
                                                          Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="BtnAddRule" Content="添加规则" Click="AddRule_Click" Padding="12,5"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,16">
                <Button x:Name="BtnExport" Content="导出配置" Padding="12,5" Margin="0,0,8,0" Click="Export_Click"/>
                <Button x:Name="BtnImport" Content="导入配置" Padding="12,5" Margin="0,0,8,0" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>


