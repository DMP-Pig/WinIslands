                                <Slider Minimum="340" Maximum="620" Value="{Binding Working.ExpandedWidth}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="ExpandedWidth" ValueChanged="SizeSlider_ValueChanged"/>
                                <CheckBox x:Name="ChkExpandedWidthAuto" IsChecked="{Binding Working.ExpandedWidthAuto}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
