                                                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="26" Height="24" Padding="0"
                                                            Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Opacity="0.75"
                                                            Click="QuickActionMove_Click" CommandParameter="{Binding Key}" Tag="-1" ToolTip="上移"/>
                                                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="26" Height="24" Padding="0"
                                                            Background="Transparent" BorderThickness="0" Opacity="0.75"
                                                            Click="QuickActionMove_Click" CommandParameter="{Binding Key}" Tag="1" ToolTip="下移"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

