                                <Slider Minimum="260" Maximum="520" Value="{Binding Working.CompactWidth}" Width="230" IsSnapToTickEnabled="True" TickFrequency="2" Tag="CompactWidth" ValueChanged="SizeSlider_ValueChanged"/>
