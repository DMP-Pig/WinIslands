                                                         VerticalAlignment="Center" Margin="2,0" Padding="3,2"
                                                         IsEnabled="{Binding SupportsIcon}" Visibility="{Binding SupportsIcon, Converter={StaticResource BoolToVis}}"
                                                         ToolTip="{Binding IconPlaceholder, StringFormat={}默认：{0}}"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding Idle, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Playing, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtCompNote" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
