                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyNext, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyPrev" Style="{StaticResource Label}"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Working.HotkeyPrev, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="LblHotkeyExpand" Style="{StaticResource Label}"/>
