                                <TextBlock x:Name="LblThemeDarkStart" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                                <Slider Minimum="0" Maximum="23" Value="{Binding Working.ThemeScheduleDarkStartHour}" Width="130" HorizontalAlignment="Left"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="LblThemeDarkEnd" Style="{StaticResource Label}" Margin="0,0,10,0"/>
