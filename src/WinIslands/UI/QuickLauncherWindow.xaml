<Window x:Class="WinIslands.UI.QuickLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIslands Launcher" Width="620" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="#F5F5FA">
    <Window.Resources>
        <!-- 选中/悬停行高亮与输入框底色：代码里随主题即时替换 -->
        <SolidColorBrush x:Key="HighlightBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#22FFFFFF"/>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="20" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="14,14,14,6">
                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                           Margin="4,0,10,0" Opacity="0.8"/>
                <Border x:Name="SearchShell" CornerRadius="12" Background="{DynamicResource InputBg}"
                        BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1">
                    <TextBox x:Name="SearchBox" FontSize="15" Padding="10,8" Background="Transparent" BorderThickness="0"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Border>
            </DockPanel>
            <TextBlock x:Name="EmptyHint" Grid.Row="1" FontSize="12" Opacity="0.75" Margin="20,4,20,6" TextWrapping="Wrap"/>
            <ListBox x:Name="ResultList" Grid.Row="2" Margin="10,2,10,4" Background="Transparent" BorderThickness="0"
                     MaxHeight="344" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="12,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                       Margin="2,0,12,0" Opacity="0.9"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FootHint" Grid.Row="3" FontSize="11" Opacity="0.6" Margin="20,4,20,12" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
