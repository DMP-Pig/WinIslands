<Window x:Class="WinIslands.UI.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIslands Clipboard" Width="440" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="#F5F5FA">
    <Window.Resources>
        <SolidColorBrush x:Key="HighlightBrush" Color="#26FFFFFF"/>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="16,14,12,8">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ClearBtn" HorizontalAlignment="Right" Padding="10,5" Margin="8,0,0,0"
                        Click="Clear_Click" Cursor="Hand" BorderThickness="1" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1" Padding="12,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
            <TextBlock x:Name="EmptyHint" Grid.Row="1" FontSize="12" Opacity="0.75" Margin="20,4,20,6" TextWrapping="Wrap"/>
            <ListBox x:Name="ResultList" Grid.Row="2" Margin="10,2,10,6" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="12,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                       Margin="2,0,12,0" Opacity="0.85"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding TimeText}" FontSize="10.5" Opacity="0.6"/>
                                <TextBlock Text="{Binding TextPreview}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FootHint" Grid.Row="3" FontSize="11" Opacity="0.6" Margin="20,2,20,12" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
