<Window x:Class="WinIslands.UI.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinIslands.UI.Converters"
        Title="WinIslands 迷你播放器" Width="336" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>

        <!-- 主题刷子：代码里随主题即时替换（圆角液态玻璃外壳） -->
        <SolidColorBrush x:Key="MiniHoverBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="MiniTextPrimary" Color="#EEF5F5FA"/>
        <SolidColorBrush x:Key="MiniTextSecondary" Color="#AAF5F5FA"/>
        <SolidColorBrush x:Key="MiniTrackBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="MiniBarBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="MiniCoverBg" Color="#6C5CE7"/>

        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MiniTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MiniHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource MiniCoverBg}">
                <Grid>
                    <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Artwork, Converter={StaticResource NullToVisInvert}}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource MiniTextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" FontSize="11" Margin="0,1,0,0"
                           Foreground="{DynamicResource MiniTextSecondary}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Height="3" Margin="0,6,0,0" Maximum="1" Minimum="0"
                             Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{DynamicResource MiniBarBrush}" Background="{DynamicResource MiniTrackBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource MiniIconButton}" Command="{Binding PreviousCommand}"
                        Content="&#xE892;" ToolTip="上一首"/>
                <Button Style="{StaticResource MiniIconButton}" Command="{Binding PlayPauseCommand}"
                        Content="{Binding PlayPauseGlyph}" FontSize="15" ToolTip="播放 / 暂停"/>
                <Button Style="{StaticResource MiniIconButton}" Command="{Binding NextCommand}"
                        Content="&#xE893;" ToolTip="下一首"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
